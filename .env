# ============================================================
# .env — Real-time Translation System Configuration
# COPY FROM .env.example and fill in your credentials
# NEVER commit this file to version control
# ============================================================

# ── Soniox STT ───────────────────────────────────────────────
# Get API key from: https://soniox.com
SONIOX_API_KEY=91d397fe09279b66bccc7dc33bd66fc5df074f922476252235c97b6b2dc9e93a

# ── Groq (Ultra-fast LLM Inference ~40ms) ────────────────────
# Get API key from: https://console.groq.com/keys
# Groq runs Llama 3 70B at ~40ms latency (vs 2-15s on HuggingFace)
GROQ_API_KEY=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

# ── ElevenLabs TTS ──────────────────────────────────────────
# Get API key from: https://elevenlabs.io
ELEVENLABS_API_KEY=5b0da912a9e9063662cf64d8f1c90d06e7e4200a11fd6e8dfcb8a4ba7b4ae2c3
# Voice IDs per language — get from ElevenLabs dashboard
# These are example IDs, replace with your actual voice IDs
EL_VOICE_HI=21m00Tcm4TlvDq8ikWAM
EL_VOICE_TE=AZnzlk1XvdvUeBnXmlld
EL_VOICE_TA=EXAVITQu4vr4xnSDxMaL
EL_VOICE_ML=Lcf7u9D9qcD9L57kCHp
EL_VOICE_KN=flq6f7yk4E4f6f7Y4
EL_VOICE_EN=ThT5KcBe7VKPt7No7
EL_VOICE_ES=ErXwobaYiN019PkySvjV
EL_VOICE_FR=MF3mGyEYCl7XYWbV9V6O
EL_VOICE_DE=TxGEqnHWrfWFTfGW9XjX

# ── Redis ────────────────────────────────────────────────────
# Redis for caching and session management (optional)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Application ──────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ── Server Configuration ─────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Service Names ────────────────────────────────────────────
SERVICE_NAME=realtime-translation-engine

# ── Supported Languages ─────────────────────────────────────
# Tamil, English, Malayalam, Telugu, Kannada, Hindi
SUPPORTED_LANGUAGES=ta,en,ml,te,kn,hi

# ── Performance Settings ────────────────────────────────────
# Connection timeouts (seconds)
ASR_TIMEOUT=30
TRANSLATION_TIMEOUT=30
TTS_TIMEOUT=30

# Max retries for API failures
MAX_RETRIES=2

# ── Logging ──────────────────────────────────────────────
LOG_FORMAT=json
LOG_FILE=/var/log/realtime-translation/app.log

# ── Security ────────────────────────────────────────────
# CORS settings
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# API rate limiting (requests per minute)
RATE_LIMIT_RPS=100

# ── Feature Flags ────────────────────────────────────────
# Enable/disable specific features
ENABLE_CACHING=true
ENABLE_METRICS=true
ENABLE_SWAGGER_UI=true
ENABLE_PROFILING=false

# ── Cache Settings ──────────────────────────────────────
# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# ── Model Settings ──────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
TRANSLATION_MODEL_SIZE=70b

# ── Monitoring & Observability ────────────────────────
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090
JAEGER_ENABLED=false
JAEGER_HOST=localhost
JAEGER_PORT=6831
