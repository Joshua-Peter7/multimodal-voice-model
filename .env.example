# Environment Template - Real-Time 6-Language Indian Translation System
# Copy this to .env and fill in your actual values

# ============ APPLICATION ============
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
SERVICE_NAME=multimodal-voice-realtime

# ============ SERVER ============
SERVER_HOST=localhost
SERVER_PORT=5000
GATEWAY_PORT=5000

# ============ SERVICE PORTS ============
ASR_PORT=5002
TRANSLATION_PORT=5003
TTS_PORT=5005

# ============ ASR SERVICE (Sonix Speech-to-Text) ============
# Sign up at: https://sonix.ai
ASR_SONIX_API_KEY=your-sonix-api-key-here
ASR_SONIX_WORKSPACE_TOKEN=your-sonix-workspace-token-here
ASR_TIMEOUT_MS=8000
ASR_MAX_RETRIES=2

# ============ TRANSLATION SERVICE (Llama via LLM Provider) ============
# Choose ONE provider and fill in its API key

# Option 1: Anthropic Claude (recommended)
TRANSLATION_PROVIDER=anthropic
TRANSLATION_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
TRANSLATION_ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Option 2: OpenAI GPT-4 (uncomment to use)
# TRANSLATION_PROVIDER=openai
# TRANSLATION_OPENAI_API_KEY=sk-proj-your-openai-key-here
# TRANSLATION_OPENAI_MODEL=gpt-4

# Option 3: HuggingFace Llama (uncomment to use)
# TRANSLATION_PROVIDER=huggingface
# TRANSLATION_HUGGINGFACE_API_KEY=hf_your-huggingface-token-here
# TRANSLATION_HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-chat-hf

TRANSLATION_MODEL=llama-2-7b
TRANSLATION_TIMEOUT_MS=10000
TRANSLATION_MAX_RETRIES=2

# ============ TTS SERVICE (ElevenLabs Text-to-Speech) ============
# Sign up at: https://elevenlabs.io
TTS_ELEVENLABS_API_KEY=sk_your-eleven-labs-api-key-here
TTS_TIMEOUT_MS=15000
TTS_MAX_RETRIES=2

# ElevenLabs Voice IDs (customize if needed)
TTS_VOICE_TAMIL=tamil-female-1
TTS_VOICE_ENGLISH=english-female-1
TTS_VOICE_TELUGU=telugu-female-1
TTS_VOICE_MALAYALAM=malayalam-female-1
TTS_VOICE_KANNADA=kannada-female-1
TTS_VOICE_HINDI=hindi-female-1

# ============ FINE-TUNING ============
TTS_SPEED=1.0
TTS_STABILITY=0.75
TTS_SIMILARITY_BOOST=0.75

# ============ CORS ============
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ============ DEVELOPMENT (set to false in production) ============
ENABLE_SWAGGER=true
ENABLE_MOCK_APIS=false

# Local Storage
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_PATH=./data/uploads

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Monitoring
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_API_KEY=your-grafana-api-key

# Jaeger Tracing
JAEGER_HOST=localhost
JAEGER_PORT=6831
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.1

# Datadog (optional)
DATADOG_ENABLED=false
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# Feature Flags
FEATURE_STREAMING_ASR=true
FEATURE_CONTEXT_PRESERVATION=true
FEATURE_PII_DETECTION=true
FEATURE_TOXICITY_CHECKING=true
FEATURE_SPEAKER_DIARIZATION=false
FEATURE_EMOTION_ANALYSIS=false

# AWS/Cloud
AWS_REGION=us-west-2
AWS_PROFILE=default

# Service Discovery
SERVICE_DISCOVERY_ENABLED=true
SERVICE_DISCOVERY_BACKEND=consul
CONSUL_HOST=localhost
CONSUL_PORT=8500

# ML Model Settings
MODEL_CACHE_SIZE_MB=2000
MODEL_PRELOAD=["en", "es", "fr"]
