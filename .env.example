# ============================================================
# .env.example — Copy to .env and fill in your credentials
# NEVER commit .env to version control
# ============================================================

# ── Soniox STT ───────────────────────────────────────────────
SONIOX_API_KEY=your_soniox_api_key_here

# ── HuggingFace (Llama 7B / 8B) ─────────────────────────────
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Dedicated Inference Endpoint URL (recommended for production)
# Leave blank to use shared inference API
HF_ENDPOINT_URL=

# ── ElevenLabs TTS ──────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice IDs per language — get from ElevenLabs dashboard
EL_VOICE_HI=21m00Tcm4TlvDq8ikWAM
EL_VOICE_TE=AZnzlk1XvdvUeBnXmlld
EL_VOICE_TA=EXAVITQu4vr4xnSDxMaL
EL_VOICE_ES=ErXwobaYiN019PkySvjV
EL_VOICE_FR=MF3mGyEYCl7XYWbV9V6O
EL_VOICE_DE=TxGEqnHWrfWFTfGW9XjX

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=

# ── App ──────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
